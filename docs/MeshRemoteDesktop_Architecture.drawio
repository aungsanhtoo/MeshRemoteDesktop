Point"/></mxGeometry></mxCell><mxCell id="c20" value="Accept / Deny" style="html=1;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="530" as="sourcePoint"/><mxPoint x="950" y="530" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;alt&lt;/b&gt;  [denied]  PKT_HANDSHAKE_DENY → close sockets → 'Failed: …' shown on Connect page" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;shape=note;size=14;fillColor=#FDECEA;strokeColor=#B85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="568" width="500" height="30" as="geometry"/></mxCell><mxCell id="c22" value="PKT_HANDSHAKE_ACK" style="html=1;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;dashed=1;strokeColor=#6C8EBF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="618" as="sourcePoint"/><mxPoint x="580" y="618" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="start recv_loop() thread" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="480" y="656" width="200" height="30" as="geometry"/></mxCell><mxCell id="c24" value="spawn VideoStream, Heartbeat, Input,&lt;br&gt;StatusWindow threads" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="810" y="700" width="280" height="40" as="geometry"/></mxCell><mxCell id="c25" value="TCP connect AUDIO :55002 → WM_APP_CONNECTED" style="html=1;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;strokeColor=#82B366;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="764" as="sourcePoint"/><mxPoint x="950" y="764" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="create session window&lt;br&gt;start AudioPlaybackThread" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="220" y="802" width="220" height="40" as="geometry"/></mxCell><mxCell id="c27" value="PKT_VIDEO_FRAME  [cursor x, y, JPEG] (AES-CTR) ~30 fps, adaptive quality" style="html=1;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;dashed=1;strokeColor=#6C8EBF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="890" as="sourcePoint"/><mxPoint x="580" y="890" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="frame_callback → PostMessage(WM_APP_FRAME) → decode_jpeg + blit" style="html=1;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="938" as="sourcePoint"/><mxPoint x="330" y="938" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="PKT_HEARTBEAT (every 5 s)" style="html=1;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;dashed=1;strokeColor=#6C8EBF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="986" as="sourcePoint"/><mxPoint x="580" y="986" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="PKT_HEARTBEAT_ACK" style="html=1;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;strokeColor=#6C8EBF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="1022" as="sourcePoint"/><mxPoint x="950" y="1022" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="mouse / keyboard on canvas" style="html=1;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="1070" as="sourcePoint"/><mxPoint x="330" y="1070" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="PKT_MOUSE_EVENT (12 B) / PKT_KEY_EVENT (5 B)  (AES-CTR) → SendInput" style="html=1;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;strokeColor=#B85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="1118" as="sourcePoint"/><mxPoint x="950" y="1118" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="PKT_AUDIO_FRAME  [sample rate, PCM16] → waveOut" style="html=1;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;dashed=1;strokeColor=#82B366;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="1166" as="sourcePoint"/><mxPoint x="580" y="1166" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="&lt;b&gt;loop&lt;/b&gt;  [session active]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=none;strokeColor=#666666;dashed=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="856" width="1380" height="338" as="geometry"/></mxCell><mxCell id="c35" value="Disconnect button / close" style="html=1;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="1234" as="sourcePoint"/><mxPoint x="330" y="1234" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="PKT_DISCONNECT (video &amp;amp; input) → close sockets" style="html=1;endArrow=block;endFill=1;fontSize=11;verticalAlign=bottom;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="1282" as="sourcePoint"/><mxPoint x="950" y="1282" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="join session threads → back to accept()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="810" y="1320" width="280" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="3. Protocol &amp; Threads"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Wire Protocol &amp;amp; Thread Model" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="800" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Packet frame&lt;/b&gt; (all three sockets)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=none;strokeColor=none;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="640" height="30" as="geometry"/></mxCell><mxCell id="c3" value="type&lt;br&gt;1 byte" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="20" y="95" width="110" height="50" as="geometry"/></mxCell><mxCell id="c4" value="length&lt;br&gt;4 bytes, big-endian" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="130" y="95" width="170" height="50" as="geometry"/></mxCell><mxCell id="c5" value="payload&lt;br&gt;length bytes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="300" y="95" width="360" height="50" as="geometry"/></mxCell><mxCell id="c6" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr style=&quot;background:#DAE8FC&quot;&gt;&lt;th&gt;Code&lt;/th&gt;&lt;th&gt;Name&lt;/th&gt;&lt;th&gt;Direction / socket&lt;/th&gt;&lt;th&gt;Payload&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x01&lt;/td&gt;&lt;td&gt;HANDSHAKE&lt;/td&gt;&lt;td&gt;C → H, video&lt;/td&gt;&lt;td&gt;controller name (≤64 chars)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x02&lt;/td&gt;&lt;td&gt;HANDSHAKE_ACK&lt;/td&gt;&lt;td&gt;H → C, video&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x03&lt;/td&gt;&lt;td&gt;HANDSHAKE_DENY&lt;/td&gt;&lt;td&gt;H → C, video&lt;/td&gt;&lt;td&gt;reason text&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x04&lt;/td&gt;&lt;td&gt;VIDEO_FRAME&lt;/td&gt;&lt;td&gt;H → C, video&lt;/td&gt;&lt;td&gt;AES-CTR( host cursor x u32 · y u32 (0–65535) · JPEG )&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x05&lt;/td&gt;&lt;td&gt;HEARTBEAT&lt;/td&gt;&lt;td&gt;H → C, video&lt;/td&gt;&lt;td&gt;– (every 5 s)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x06&lt;/td&gt;&lt;td&gt;HEARTBEAT_ACK&lt;/td&gt;&lt;td&gt;C → H, video&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x10&lt;/td&gt;&lt;td&gt;MOUSE_EVENT&lt;/td&gt;&lt;td&gt;C → H, input&lt;/td&gt;&lt;td&gt;AES-CTR( x i16 · y i16 · event[4] · button[4] )&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x11&lt;/td&gt;&lt;td&gt;KEY_EVENT&lt;/td&gt;&lt;td&gt;C → H, input&lt;/td&gt;&lt;td&gt;AES-CTR( vk u32 · pressed u8 )&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x12&lt;/td&gt;&lt;td&gt;AUDIO_FRAME&lt;/td&gt;&lt;td&gt;H → C, audio&lt;/td&gt;&lt;td&gt;sample rate u32 · PCM16 samples (not encrypted)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0xFF&lt;/td&gt;&lt;td&gt;DISCONNECT&lt;/td&gt;&lt;td&gt;both&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="160" width="640" height="330" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Encryption&lt;/b&gt;&lt;br&gt;• Passphrase → DeriveKey → AES-128 key (both sides).&lt;br&gt;• CTR mode with a per-direction packet counter (video-send / input-recv), reset at handshake.&lt;br&gt;• Empty passphrase = no encryption. Mismatched keys → black screen (README)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;shape=note;size=14;fillColor=#FFF9E6;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="640" height="80" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Thread model&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=none;strokeColor=none;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="760" height="30" as="geometry"/></mxCell><mxCell id="c9" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr style=&quot;background:#D5E8D4&quot;&gt;&lt;th&gt;Process&lt;/th&gt;&lt;th&gt;Thread&lt;/th&gt;&lt;th&gt;Lifetime&lt;/th&gt;&lt;th&gt;Job&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td rowspan=&quot;5&quot;&gt;dashboard.exe&lt;br&gt;+ core.dll&lt;/td&gt;&lt;td&gt;UI (main)&lt;/td&gt;&lt;td&gt;app&lt;/td&gt;&lt;td&gt;Win32 message loop, rendering, input capture&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;connect worker&lt;/td&gt;&lt;td&gt;per connect&lt;/td&gt;&lt;td&gt;open input/video/audio sockets, handshake&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;VideoConnection::recv_loop&lt;/td&gt;&lt;td&gt;session&lt;/td&gt;&lt;td&gt;receive + decrypt frames, heartbeat ACK, bandwidth monitor&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;AudioPlaybackThread&lt;/td&gt;&lt;td&gt;session&lt;/td&gt;&lt;td&gt;receive PCM, play via waveOut&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;raw_input_loop (raw_thread)&lt;/td&gt;&lt;td&gt;session&lt;/td&gt;&lt;td&gt;Raw Input mouse sink + low-level keyboard hook → InputConnection&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td rowspan=&quot;7&quot;&gt;Host Server.exe&lt;/td&gt;&lt;td&gt;main&lt;/td&gt;&lt;td&gt;app&lt;/td&gt;&lt;td&gt;startup, listen/accept loop, consent, join session threads&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;LogWorker&lt;/td&gt;&lt;td&gt;app&lt;/td&gt;&lt;td&gt;asynchronous logging&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;AudioStreamThread&lt;/td&gt;&lt;td&gt;app&lt;/td&gt;&lt;td&gt;accept audio clients, WASAPI loopback&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;VideoStreamThread&lt;/td&gt;&lt;td&gt;session&lt;/td&gt;&lt;td&gt;capture → JPEG → encrypt → send, adaptive quality&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;HeartbeatThread&lt;/td&gt;&lt;td&gt;session&lt;/td&gt;&lt;td&gt;PKT_HEARTBEAT every 5 s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;InputThread&lt;/td&gt;&lt;td&gt;session&lt;/td&gt;&lt;td&gt;decrypt → SendInput (incl. SAS)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RunStatusWindow&lt;/td&gt;&lt;td&gt;session&lt;/td&gt;&lt;td&gt;status window + tray icon&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="700" y="95" width="760" height="430" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Adaptive video pipeline&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=none;strokeColor=none;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="800" height="30" as="geometry"/></mxCell><mxCell id="c11" value="BitBlt screen&lt;br&gt;(input desktop)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="20" y="650" width="140" height="56" as="geometry"/></mxCell><mxCell id="c12" value="GDI+ JPEG&lt;br&gt;quality q" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="200" y="650" width="140" height="56" as="geometry"/></mxCell><mxCell id="c13" value="AES-CTR&lt;br&gt;encrypt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="380" y="650" width="140" height="56" as="geometry"/></mxCell><mxCell id="c14" value="send&lt;br&gt;VIDEO_FRAME" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="560" y="650" width="140" height="56" as="geometry"/></mxCell><mxCell id="c15" value="BandwidthController&lt;br&gt;send time vs 33 ms budget&lt;br&gt;→ q ∈ {15,30,50,75}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="300" y="740" width="240" height="60" as="geometry"/></mxCell><mxCell id="c16" value="Controller: recv → decrypt →&lt;br&gt;RecvBandwidthMonitor (drop stale) →&lt;br&gt;decode_jpeg → blit to canvas" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="760" y="645" width="280" height="66" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="TCP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="elapsed ms, bytes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=1;entryY=0.5;dashed=1;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="next q" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0;exitY=0.5;entryX=0.5;entryY=1;dashed=1;" edge="1" parent="1" source="c15" target="c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="770"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="4. Build &amp; Deployment"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Build (Visual Studio 2015, toolset v140) &amp;amp; Deployment" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;SimpleRemoteDesktop_VS2015.sln&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="300" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;core.vcxproj&lt;/b&gt;&lt;br&gt;DynamicLibrary · CORE_EXPORTS&lt;br&gt;core.cpp, core.h" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="220" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;dashboard.vcxproj&lt;/b&gt;&lt;br&gt;Application (/SUBSYSTEM:WINDOWS)&lt;br&gt;dashboard.cpp · DelayLoad core.dll" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="400" y="160" width="240" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Host Server.vcxproj&lt;/b&gt;&lt;br&gt;Application (WinMain)&lt;br&gt;host.cpp (standalone, no core.dll)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="720" y="160" width="240" height="70" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;endArrow=open;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;endArrow=open;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;endArrow=open;" edge="1" parent="1" source="c2" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="ProjectReference&lt;br&gt;(links core.lib)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="core.dll + core.lib" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="220" height="36" as="geometry"/></mxCell><mxCell id="c11" value="dashboard.exe" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="400" y="290" width="240" height="36" as="geometry"/></mxCell><mxCell id="c12" value="Host Server.exe" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="720" y="290" width="240" height="36" as="geometry"/></mxCell><mxCell id="c13" value="build" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c3" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="build" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c4" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="build" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c5" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="Output: &lt;b&gt;x64\Release\&lt;/b&gt;  (x86: Release\ ; Debug: x64\Debug\ / Debug\)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="700" height="24" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Runtime folder layout&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=none;strokeColor=none;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="400" height="30" as="geometry"/></mxCell><mxCell id="c18" value="&amp;lt;app folder&amp;gt;\&lt;br&gt;&amp;nbsp;&amp;nbsp;├─ dashboard.exe&lt;br&gt;&amp;nbsp;&amp;nbsp;├─ core.dll&lt;br&gt;&amp;nbsp;&amp;nbsp;└─ core\host\&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;├─ host.exe &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;lt;- copy of &lt;b&gt;Host Server.exe&lt;/b&gt;, renamed&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;└─ settings.dat &amp;lt;- written by the dashboard Host page" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Consolas;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="435" width="520" height="130" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Two ways to run the host&lt;/b&gt;&lt;br&gt;1. From dashboard.exe → &lt;i&gt;Host RDP Connection&lt;/i&gt; → Start Host&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(needs core\host\host.exe present, else 'host.exe not found').&lt;br&gt;2. Run Host Server.exe directly with a settings.dat next to it.&lt;br&gt;&lt;br&gt;&lt;b&gt;Prerequisites&lt;/b&gt;: Visual C++ 2015 Redistributable (x64/x86) on each PC;&lt;br&gt;Host must run as Administrator; WAN needs port forwarding or UPnP." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;shape=note;size=14;fillColor=#FFF9E6;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="400" width="560" height="165" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="5. How to Run &amp; Usage"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="How to Run &amp;amp; Use Simple Remote Desktop" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="4" width="900" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Default ports: video 55000 · input 55001 · audio 55002 (TCP). Controller and host must use the same ports and the same key." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="34" width="1200" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;0. Prepare (once)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F5F5F5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1680" height="150" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Build&lt;/b&gt;&lt;br&gt;Open &lt;b&gt;SimpleRemoteDesktop_VS2015.sln&lt;/b&gt;&lt;br&gt;Release | x64 → Build Solution&lt;br&gt;Output: x64\Release\" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="35" y="105" width="300" height="100" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Controller PC&lt;/b&gt;&lt;br&gt;Copy &lt;b&gt;dashboard.exe&lt;/b&gt; + &lt;b&gt;core.dll&lt;/b&gt;&lt;br&gt;(same folder)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="368" y="105" width="300" height="100" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;endArrow=open;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="&lt;b&gt;Host PC&lt;/b&gt;&lt;br&gt;Copy dashboard.exe + core.dll, and&lt;br&gt;&lt;b&gt;Host Server.exe&lt;/b&gt; → &lt;b&gt;core\host\host.exe&lt;/b&gt;&lt;br&gt;(or use Host Server.exe on its own)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="701" y="105" width="300" height="100" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;endArrow=open;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;Runtime&lt;/b&gt;&lt;br&gt;Install &lt;b&gt;Visual C++ 2015&lt;/b&gt;&lt;br&gt;Redistributable (x64) on both PCs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1034" y="105" width="300" height="100" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;endArrow=open;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;Network&lt;/b&gt;&lt;br&gt;Same LAN: nothing to do.&lt;br&gt;Over the internet: forward TCP&lt;br&gt;55000–55002 to the host (or UPnP)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1367" y="105" width="300" height="100" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;endArrow=open;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;A. Host PC – share this computer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#EEF7EA;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="830" height="760" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Option 1 – from the dashboard (recommended)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="274" width="600" height="20" as="geometry"/></mxCell><mxCell id="c15" value="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;ellipse;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="307" width="26" height="26" as="geometry"/></mxCell><mxCell id="c16" value="Run &lt;b&gt;dashboard.exe&lt;/b&gt; → click &lt;b&gt;Host RDP Connection&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="298" width="740" height="44" as="geometry"/></mxCell><mxCell id="c17" value="2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;ellipse;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="363" width="26" height="26" as="geometry"/></mxCell><mxCell id="c18" value="Set &lt;b&gt;Video / Input / Audio port&lt;/b&gt; (default 55000 / 55001 / 55002)&lt;br&gt;Tick &lt;b&gt;WAN Mode (public IP / hostname)&lt;/b&gt; only if the controller is on another network" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="354" width="740" height="44" as="geometry"/></mxCell><mxCell id="c19" value="3" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;ellipse;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="419" width="26" height="26" as="geometry"/></mxCell><mxCell id="c20" value="Enter a &lt;b&gt;Key&lt;/b&gt; (encryption passphrase) – leave blank to disable encryption&lt;br&gt;Give the same key to the controller user" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="410" width="740" height="44" as="geometry"/></mxCell><mxCell id="c21" value="4" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;ellipse;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="475" width="26" height="26" as="geometry"/></mxCell><mxCell id="c22" value="Click &lt;b&gt;Start Host&lt;/b&gt; → accept the UAC prompt.&lt;br&gt;The dashboard writes core\host\settings.dat, starts host.exe and hides to the tray (&quot;Host Running&quot;)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="466" width="740" height="44" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Option 2 – run the host directly&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="518" width="600" height="20" as="geometry"/></mxCell><mxCell id="c24" value="Put a &lt;b&gt;settings.dat&lt;/b&gt; next to &lt;b&gt;Host Server.exe&lt;/b&gt; (see the example on the right) → right-click → &lt;b&gt;Run as administrator&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="542" width="450" height="52" as="geometry"/></mxCell><mxCell id="c25" value="# settings.dat&lt;br&gt;video_port = 55000&lt;br&gt;input_port = 55001&lt;br&gt;audio_port = 55002&lt;br&gt;connection = LAN&amp;nbsp;&amp;nbsp;&amp;nbsp;# or WAN&lt;br&gt;passphrase = MySecretKey&lt;br&gt;startup = no" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Consolas;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="536" width="275" height="118" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Prompts you may see when the host starts&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="666" width="600" height="20" as="geometry"/></mxCell><mxCell id="c27" value="!" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;ellipse;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="695" width="26" height="26" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Administrator Required&lt;/b&gt; → OK = restart as admin (required for input injection &amp;amp; Ctrl+Alt+Del)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="690" width="740" height="36" as="geometry"/></mxCell><mxCell id="c29" value="!" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;ellipse;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="743" width="26" height="26" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;SendSAS Registry Key Missing&lt;/b&gt; → OK = enable remote Ctrl+Alt+Del (one-time registry change)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="738" width="740" height="36" as="geometry"/></mxCell><mxCell id="c31" value="!" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;ellipse;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="791" width="26" height="26" as="geometry"/></mxCell><mxCell id="c32" value="Firewall rule UAC prompt (netsh) · WAN mode: UPnP result message · &lt;b&gt;Startup Registration&lt;/b&gt; if startup = yes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="786" width="740" height="36" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;During a session&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="600" height="20" as="geometry"/></mxCell><mxCell id="c34" value="5" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;ellipse;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="863" width="26" height="26" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Remote Desktop - Access Request&lt;/b&gt; shows the controller's name → &lt;b&gt;Yes&lt;/b&gt; to allow, &lt;b&gt;No&lt;/b&gt; to deny&lt;br&gt;While connected, a red watermark is shown on the host screen" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="854" width="740" height="44" as="geometry"/></mxCell><mxCell id="c36" value="6" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;ellipse;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="919" width="26" height="26" as="geometry"/></mxCell><mxCell id="c37" value="To end: host tray icon → &lt;b&gt;Disconnect remote session&lt;/b&gt;&lt;br&gt;To stop hosting: dashboard tray icon → Disconnect → confirm &quot;Are you sure you want to disconnect?&quot;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="910" width="740" height="44" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;B. Controller PC – connect to a host&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#EAF2FB;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="870" y="240" width="830" height="470" as="geometry"/></mxCell><mxCell id="c39" value="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;ellipse;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="890" y="294" width="26" height="26" as="geometry"/></mxCell><mxCell id="c40" value="Run &lt;b&gt;dashboard.exe&lt;/b&gt; → click &lt;b&gt;Connect to Device&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="285" width="750" height="44" as="geometry"/></mxCell><mxCell id="c41" value="2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;ellipse;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="890" y="350" width="26" height="26" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Host / IP&lt;/b&gt;: the host's address, e.g. 192.168.1.10 · mypc.ddns.net · 203.0.113.5&lt;br&gt;&lt;b&gt;Your name&lt;/b&gt;: shown to the host user in the access request (default &quot;Controller&quot;)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="341" width="750" height="44" as="geometry"/></mxCell><mxCell id="c43" value="3" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;ellipse;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="890" y="406" width="26" height="26" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Video / Input / Audio port&lt;/b&gt;: must match the host's settings (default 55000 / 55001 / 55002)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="397" width="750" height="44" as="geometry"/></mxCell><mxCell id="c45" value="4" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;ellipse;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="890" y="462" width="26" height="26" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Host Key&lt;/b&gt;: the same key the host entered – leave blank if the host has no key" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="453" width="750" height="44" as="geometry"/></mxCell><mxCell id="c47" value="5" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;ellipse;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="890" y="518" width="26" height="26" as="geometry"/></mxCell><mxCell id="c48" value="Click &lt;b&gt;Connect to Desktop&lt;/b&gt; → &quot;Connecting...&quot; overlay (Cancel to abort).&lt;br&gt;Keeps retrying while the host starts: up to 60 s on LAN, 300 s in WAN mode" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="509" width="750" height="44" as="geometry"/></mxCell><mxCell id="c49" value="6" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;ellipse;fillColor=#333333;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="890" y="574" width="26" height="26" as="geometry"/></mxCell><mxCell id="c50" value="The host user clicks &lt;b&gt;Yes&lt;/b&gt; → the session window opens with the live screen and audio" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="565" width="750" height="44" as="geometry"/></mxCell><mxCell id="c51" value="The status bar shows whether the session is encrypted. If the keys do not match, you see a black screen." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;shape=note;size=14;fillColor=#FFF9E6;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="621" width="750" height="34" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;C. Session window controls&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#EAF2FB;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="870" y="725" width="830" height="275" as="geometry"/></mxCell><mxCell id="c53" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr style=&quot;background:#DAE8FC&quot;&gt;&lt;th&gt;Action&lt;/th&gt;&lt;th&gt;What it does&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Click inside the stream&lt;/td&gt;&lt;td&gt;Lock the cursor and start controlling the host mouse &amp;amp; keyboard&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Esc&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Unlock the cursor (Esc is not sent to the host)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Ctrl+Alt+Del · Ctrl+Shift+Esc · Alt+Tab&lt;/td&gt;&lt;td&gt;Sent to the host (Ctrl+Alt+Del needs the SendSAS key on the host)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Volume&lt;/b&gt; button&lt;/td&gt;&lt;td&gt;Choose the audio level (Mute … 100 %)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Debug (F12)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Show or hide the stats overlay (FPS, bitrate, congestion)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Disconnect&lt;/b&gt; button / close window&lt;/td&gt;&lt;td&gt;End the session and go back to the Connect page&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="885" y="760" width="800" height="225" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;D. Troubleshooting&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FDECEA;strokeColor=#B85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="1020" width="1680" height="265" as="geometry"/></mxCell><mxCell id="c55" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr style=&quot;background:#F8CECC&quot;&gt;&lt;th&gt;Symptom&lt;/th&gt;&lt;th&gt;Cause / fix&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Black screen after connecting&lt;/td&gt;&lt;td&gt;Host Key on the controller does not match the host key – re-enter the same key on both sides&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&quot;Failed: could not connect input channel&quot;&lt;/td&gt;&lt;td&gt;Host not running, wrong IP/ports, or firewall/router blocking TCP 55000–55002&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Connection denied&lt;/td&gt;&lt;td&gt;The host user clicked &lt;b&gt;No&lt;/b&gt; in the Access Request dialog&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Works on LAN but not over the internet&lt;/td&gt;&lt;td&gt;Forward TCP 55000–55002 on the host router (UPnP maps only video &amp;amp; input, not audio). Double NAT / CGNAT → use a VPN (Tailscale, ZeroTier, WireGuard)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;No sound&lt;/td&gt;&lt;td&gt;Audio port 55002 not reachable, or volume set to Mute&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&quot;host.exe not found in core\host\&quot;&lt;/td&gt;&lt;td&gt;Copy Host Server.exe to &amp;lt;dashboard folder&amp;gt;\core\host\host.exe&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&quot;Remote Desktop Host is already running&quot;&lt;/td&gt;&lt;td&gt;Only one host instance is allowed – stop the existing one from the tray first&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Ctrl+Alt+Del does nothing&lt;/td&gt;&lt;td&gt;Accept the SendSAS registry prompt on the host (or add HKLM\...\Policies\System SoftwareSASGeneration = 1)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;App will not start: MSVCP140.dll / VCRUNTIME140.dll missing&lt;/td&gt;&lt;td&gt;Install the Visual C++ 2015 Redistributable&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="35" y="1050" width="1650" height="225" as="geometry"/></mxCell><mxCell id="c56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;strokeColor=#666666;endArrow=open;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c22" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;strokeColor=#666666;endArrow=open;exitX=0;exitY=0.5;entryX=1;entryY=0.5;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c50" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="6. Internet Connectivity Plan"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1320" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Connecting Across Different Networks (Internet) – Integration Plan" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="4" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Today the host &lt;b&gt;listens&lt;/b&gt; on TCP 55000–55002 and the controller dials its IP directly. That only works when the host is reachable from the internet." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="34" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c3" value="1. Today: direct connection (fails behind NAT)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F5F5F5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="830" height="250" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Controller&lt;/b&gt;&lt;br&gt;dashboard.exe" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="140" height="56" as="geometry"/></mxCell><mxCell id="c5" value="Internet" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;ellipse;shape=cloud;fillColor=#FFFFFF;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="140" width="120" height="56" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Router / NAT&lt;/b&gt;&lt;br&gt;CGNAT · double NAT&lt;br&gt;firewall" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="132" width="150" height="72" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Host&lt;/b&gt;&lt;br&gt;host.exe listen()&lt;br&gt;:55000-55002" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="680" y="140" width="150" height="56" as="geometry"/></mxCell><mxCell id="c8" value="connect&lt;br&gt;IP:55000" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#F5F5F5;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="✗ blocked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;strokeColor=#B85450;fontColor=#B85450;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="Fails when: no public IP (CGNAT – most mobile / 4G and many ISPs) · double NAT · company / hotel firewalls · changing home IP.&lt;br&gt;Works only with manual port forwarding or UPnP (and UPnP maps only video + input, not audio)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;shape=note;size=14;fillColor=#FDECEA;strokeColor=#B85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="225" width="790" height="80" as="geometry"/></mxCell><mxCell id="c12" value="2. Options" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F5F5F5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="870" y="70" width="830" height="250" as="geometry"/></mxCell><mxCell id="c13" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr style=&quot;background:#DAE8FC&quot;&gt;&lt;th&gt;#&lt;/th&gt;&lt;th&gt;Module to integrate&lt;/th&gt;&lt;th&gt;Code change&lt;/th&gt;&lt;th&gt;Notes&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;&lt;b&gt;Overlay VPN&lt;/b&gt; – Tailscale / ZeroTier / WireGuard&lt;/td&gt;&lt;td&gt;None&lt;/td&gt;&lt;td&gt;Install on both PCs, connect to the host VPN IP (100.x.y.z). Traverses CGNAT, encrypted. &lt;b&gt;Use today.&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;&lt;b&gt;Port tunnel&lt;/b&gt; – frp (frps on a VPS + frpc on the host) / ngrok TCP&lt;/td&gt;&lt;td&gt;None&lt;/td&gt;&lt;td&gt;Publishes 55000–55002 through a public server. Quick prototype.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;&lt;b&gt;Relay + rendezvous server&lt;/b&gt; (TeamViewer / AnyDesk model)&lt;/td&gt;&lt;td&gt;Medium&lt;/td&gt;&lt;td&gt;&lt;b&gt;Recommended for a product&lt;/b&gt; – see target architecture below.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;&lt;b&gt;WebRTC&lt;/b&gt; – libdatachannel (ICE / STUN / TURN + DTLS)&lt;/td&gt;&lt;td&gt;Large&lt;/td&gt;&lt;td&gt;Best P2P. Needs C++17 → VS2017 or newer (not VS2015).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;&lt;b&gt;ZeroTier libzt&lt;/b&gt; (embedded C SDK)&lt;/td&gt;&lt;td&gt;Medium&lt;/td&gt;&lt;td&gt;Like option 1 but inside the app. Check the license for commercial use.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="885" y="100" width="800" height="210" as="geometry"/></mxCell><mxCell id="c14" value="3. Target architecture (option 3): both sides connect OUT to a relay server" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F5F5F5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="340" width="1680" height="470" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Controller PC&lt;/b&gt;&lt;br&gt;&lt;br&gt;dashboard.exe&lt;br&gt;+ core.dll&lt;br&gt;&lt;br&gt;• enter &lt;b&gt;Host ID + password&lt;/b&gt;&lt;br&gt;• TLS client (Schannel)&lt;br&gt;• one multiplexed connection" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="420" width="300" height="190" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Host PC&lt;/b&gt;&lt;br&gt;&lt;br&gt;host.exe (outbound mode)&lt;br&gt;&lt;br&gt;• registers &lt;b&gt;Host ID&lt;/b&gt;, shows password&lt;br&gt;• TLS client (Schannel)&lt;br&gt;• one multiplexed connection&lt;br&gt;• no inbound ports / no UPnP needed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1370" y="420" width="300" height="190" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Cloud server&lt;/b&gt; (VPS with public IP, e.g. port 443)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F3EEF7;strokeColor=#9673A6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="450" y="385" width="820" height="300" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;ID / signaling service&lt;/b&gt;&lt;br&gt;• host registers ID, keeps connection alive&lt;br&gt;• controller asks for ID → server checks password&lt;br&gt;• tells both sides to join a session" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="470" y="425" width="380" height="90" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;TCP relay&lt;/b&gt;&lt;br&gt;• pairs controller ↔ host by session token&lt;br&gt;• forwards bytes both ways (end-to-end TLS)&lt;br&gt;• bandwidth / session limits" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="870" y="425" width="380" height="90" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;STUN / TURN&lt;/b&gt; (optional, phase 4)&lt;br&gt;• discovers public address for hole punching&lt;br&gt;• relay fallback if P2P fails" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="470" y="530" width="380" height="74" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Accounts / devices DB&lt;/b&gt; (optional)&lt;br&gt;host IDs, hashed passwords, rate limiting, audit log" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="870" y="530" width="380" height="74" as="geometry"/></mxCell><mxCell id="c22" value="Server can be written in C++ (Winsock / Linux epoll), Go or Node – it only routes bytes; screen data never needs to be decoded there." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;shape=note;size=14;fillColor=#FFF9E6;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="618" width="780" height="52" as="geometry"/></mxCell><mxCell id="c23" value="① TLS :443&lt;br&gt;connect to ID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#6C8EBF;strokeWidth=2;exitX=1;exitY=0.25;entryX=0;entryY=0.5;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="② outbound&lt;br&gt;TLS :443&lt;br&gt;register + wait" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#82B366;strokeWidth=2;exitX=0;exitY=0.25;entryX=1;entryY=0.5;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c16" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="③ optional direct P2P after hole punching (phase 4)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;strokeColor=#666666;endArrow=open;startArrow=open;exitX=0.5;exitY=1;entryX=0.5;entryY=1;labelBackgroundColor=#F5F5F5;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="760"/><mxPoint x="1520" y="760"/></Array></mxGeometry></mxCell><mxCell id="c26" value="Session data still flows: video + audio host → controller, input controller → host – but inside ONE encrypted connection through the relay." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;shape=note;size=14;fillColor=#FFF9E6;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="700" width="1010" height="34" as="geometry"/></mxCell><mxCell id="c27" value="4. Single multiplexed connection" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F5F5F5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="830" width="830" height="200" as="geometry"/></mxCell><mxCell id="c28" value="channel&lt;br&gt;1 B" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="875" width="110" height="50" as="geometry"/></mxCell><mxCell id="c29" value="type&lt;br&gt;1 B" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="150" y="875" width="100" height="50" as="geometry"/></mxCell><mxCell id="c30" value="length&lt;br&gt;4 B big-endian" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="250" y="875" width="160" height="50" as="geometry"/></mxCell><mxCell id="c31" value="payload" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="410" y="875" width="420" height="50" as="geometry"/></mxCell><mxCell id="c32" value="channel: 0 = video · 1 = input · 2 = audio · 3 = control (heartbeat, disconnect).&lt;br&gt;Existing packet types and payloads stay the same – only the extra channel byte is new.&lt;br&gt;Replaces the 3 sockets (55000 / 55001 / 55002) → one port, much easier to relay and to pass firewalls." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;shape=note;size=14;fillColor=#FFF9E6;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="790" height="76" as="geometry"/></mxCell><mxCell id="c33" value="5. Security – required before using the internet" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F5F5F5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="870" y="830" width="830" height="200" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Current AES-CTR is not safe on the internet&lt;/b&gt;&lt;br&gt;• counter +1 per packet but +1 per 16-byte block inside → keystream reused between frames&lt;br&gt;• video and input share key and start at 0; counters reset every session&lt;br&gt;• no integrity check (packets can be modified) · home-made key derivation · audio unencrypted" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;shape=note;size=14;fillColor=#FDECEA;strokeColor=#B85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="885" y="865" width="400" height="150" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Replace with&lt;/b&gt;&lt;br&gt;• &lt;b&gt;TLS via Windows Schannel&lt;/b&gt; (built into Windows, works with VS2015, no extra DLL)&lt;br&gt;&amp;nbsp;&amp;nbsp;– or the encryption of the VPN / WebRTC option&lt;br&gt;• per-session random password, PBKDF2 (BCrypt API) for stored passwords&lt;br&gt;• rate limiting / lockout on failed attempts" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;shape=note;size=14;fillColor=#FFF9E6;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1295" y="865" width="390" height="150" as="geometry"/></mxCell><mxCell id="c36" value="6. Roadmap" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F5F5F5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="1050" width="1680" height="250" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Phase 0 – now&lt;/b&gt;&lt;br&gt;&lt;br&gt;Use &lt;b&gt;Tailscale&lt;/b&gt; (or ZeroTier) on both PCs.&lt;br&gt;No code change." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1095" width="300" height="140" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Phase 1 – client&lt;/b&gt;&lt;br&gt;&lt;br&gt;One multiplexed connection.&lt;br&gt;Host &lt;b&gt;outbound-connect mode&lt;/b&gt;&lt;br&gt;(keep LAN listen mode as option)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="373" y="1095" width="300" height="140" as="geometry"/></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;endArrow=block;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="&lt;b&gt;Phase 2 – server&lt;/b&gt;&lt;br&gt;&lt;br&gt;Relay + ID / signaling server.&lt;br&gt;Host ID + one-time password UI&lt;br&gt;in the dashboard." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="706" y="1095" width="300" height="140" as="geometry"/></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;endArrow=block;" edge="1" parent="1" source="c38" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="&lt;b&gt;Phase 3 – security&lt;/b&gt;&lt;br&gt;&lt;br&gt;Schannel TLS end-to-end,&lt;br&gt;authentication, rate limiting.&lt;br&gt;&lt;b&gt;Must ship with phase 2.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1039" y="1095" width="300" height="140" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;endArrow=block;" edge="1" parent="1" source="c40" target="c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="&lt;b&gt;Phase 4 – P2P&lt;/b&gt;&lt;br&gt;&lt;br&gt;STUN hole punching with&lt;br&gt;relay fallback, or WebRTC&lt;br&gt;(requires VS2017+)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1372" y="1095" width="300" height="140" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;endArrow=block;" edge="1" parent="1" source="c42" target="c44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c46" value="Effort grows left → right. Phases 1–3 together give a TeamViewer-style experience: connect by ID + password from any network without router changes." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="1250" width="1600" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>