<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0"><diagram id="p0" name="1. System Architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Simple Remote Desktop – System Architecture" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="4" width="900" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Native C++ / Win32, VS2015 (v140). Two machines: the &lt;b&gt;Controller&lt;/b&gt; views &amp;amp; controls, the &lt;b&gt;Host&lt;/b&gt; is being controlled." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="32" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c3" value="Controller PC" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#EAF2FB;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="660" height="980" as="geometry"/></mxCell><mxCell id="c4" value="dashboard.exe  (Win32 GUI – class ControllerApp)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="620" height="378" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Main window / page router&lt;/b&gt;&lt;br&gt;switch_page(): Dashboard · Connect · Host" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="55" y="145" width="290" height="50" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Connect page&lt;/b&gt; (RC)&lt;br&gt;IP/domain, name, video/input/audio port,&lt;br&gt;passphrase, WAN mode → on_connect()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="55" y="210" width="290" height="66" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Connect worker thread&lt;/b&gt; (detached)&lt;br&gt;creates InputConnection + VideoConnection,&lt;br&gt;opens audio socket; retry until deadline&lt;br&gt;(LAN 60 s / WAN 300 s)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="55" y="292" width="290" height="74" as="geometry"/></mxCell><mxCell id="c8" value="Loading overlay · consent dialog · tray icon" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="55" y="380" width="290" height="30" as="geometry"/></mxCell><mxCell id="c9" value="UI thread = Win32 message loop. Workers notify it with PostMessage(WM_APP_STATUS / FRAME / CONNECTED / DISCONN)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;shape=note;size=14;fillColor=#FFF9E6;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="422" width="290" height="56" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Host page&lt;/b&gt;&lt;br&gt;ports, passphrase, WAN → on_start_host()&lt;br&gt;writes settings.dat, CreateProcess host.exe" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="360" y="145" width="285" height="66" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Session window&lt;/b&gt;&lt;br&gt;Canvas (render_frame, scaled blit)&lt;br&gt;toolbar: Disconnect · Volume · Debug (F12)&lt;br&gt;status bar (AES on/off, FPS, bitrate)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="360" y="226" width="285" height="82" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Input capture&lt;/b&gt; (raw_thread)&lt;br&gt;Raw Input mouse + WH_KEYBOARD_LL hook&lt;br&gt;→ send_mouse() / send_key(); Esc = unlock" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="360" y="322" width="285" height="66" as="geometry"/></mxCell><mxCell id="c13" value="core.dll  (shared client library, exports CORE_API)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="620" height="420" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;AES-128 CTR&lt;/b&gt;&lt;br&gt;DeriveKey(passphrase), KeyExpansion&lt;br&gt;CryptVideoRecv / CryptInputSend" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="55" y="545" width="290" height="66" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Packet framing&lt;/b&gt;&lt;br&gt;make_packet / send_packet /&lt;br&gt;recv_exact / recv_packet" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="55" y="625" width="290" height="60" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;JPEG decode &amp;amp; blit&lt;/b&gt; (GDI+)&lt;br&gt;decode_jpeg → HBITMAP, blit_bitmap,&lt;br&gt;make_remote_cursor_bmp" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="55" y="699" width="290" height="60" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;RecvBandwidthMonitor&lt;/b&gt;&lt;br&gt;EMA fps, throughput, congestion →&lt;br&gt;drops stale frames (target 30 fps)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="55" y="773" width="290" height="60" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Port / state config&lt;/b&gt;&lt;br&gt;Core_SetVideoPorts, Core_SetupAES,&lt;br&gt;Core_ResetAESCounters, Core_Bw*" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="55" y="847" width="290" height="60" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;InputConnection&lt;/b&gt;&lt;br&gt;send_mouse(x,y,event,button) 12 B&lt;br&gt;send_key(vk, pressed) 5 B" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="360" y="545" width="285" height="66" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;VideoConnection&lt;/b&gt;&lt;br&gt;connect_video(): PKT_HANDSHAKE(name)&lt;br&gt;recv_loop() thread: frames, heartbeat ACK" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="360" y="625" width="285" height="66" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;AudioPlaybackThread&lt;/b&gt;&lt;br&gt;PKT_AUDIO_FRAME → PCM16 →&lt;br&gt;waveOut (WinMM); volume control" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="360" y="705" width="285" height="66" as="geometry"/></mxCell><mxCell id="c22" value="Network-facing classes (right column) use the helpers on the left: framing, AES, decode, bandwidth monitor." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;shape=note;size=14;fillColor=#FFF9E6;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="790" width="285" height="56" as="geometry"/></mxCell><mxCell id="c23" value="Winsock2 · GDI / GDI+ · WinMM waveOut · Raw Input · ComCtl32" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="945" width="620" height="30" as="geometry"/></mxCell><mxCell id="c24" value="Deployment: dashboard.exe + core.dll in the same folder (core.dll is delay-loaded)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;shape=note;size=14;fillColor=#FFF9E6;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="620" height="50" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;endArrow=open;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="spawn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;endArrow=open;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="mouse / key" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c12" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="c20" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="352" y="658"/><mxPoint x="352" y="267"/></Array></mxGeometry></mxCell><mxCell id="c29" value="◄ dashed: frame_callback →&lt;br&gt;PostMessage(WM_APP_FRAME)&lt;br&gt;→ render on canvas" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="360" y="400" width="140" height="50" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Network&lt;/b&gt;&lt;br&gt;LAN, or WAN via router&lt;br&gt;(port forwarding / UPnP)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;ellipse;shape=cloud;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="745" y="420" width="180" height="100" as="geometry"/></mxCell><mxCell id="c31" value="3 TCP connections (TCP_NODELAY)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontStyle=2;align=center;" vertex="1" parent="1"><mxGeometry x="715" y="525" width="260" height="20" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;INPUT&lt;/b&gt;  TCP :55001&lt;br&gt;controller → host · AES" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="715" y="560" width="260" height="36" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;VIDEO&lt;/b&gt;  TCP :55000&lt;br&gt;host → controller · AES · heartbeat" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="715" y="640" width="260" height="36" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;AUDIO&lt;/b&gt;  TCP :55002&lt;br&gt;host → controller · not encrypted" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="715" y="720" width="260" height="36" as="geometry"/></mxCell><mxCell id="c35" value="Host PC (machine being controlled)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#EEF7EA;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1020" y="80" width="680" height="980" as="geometry"/></mxCell><mxCell id="c36" value="Host Server.exe  (deployed as core\host\host.exe)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1040" y="112" width="640" height="818" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Startup (WinMain)&lt;/b&gt;&lt;br&gt;IsRunningAsAdmin → else RelaunchAsAdmin (UAC runas)&lt;br&gt;LoadSettings(settings.dat)  · optional startup-app registry&lt;br&gt;SoftwareSASGeneration key (enables Ctrl+Alt+Del)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1055" y="145" width="610" height="74" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;EnsureFirewallRules&lt;/b&gt;&lt;br&gt;netsh advfirewall (video/input/audio)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1055" y="232" width="300" height="50" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;UPnPOpenPorts&lt;/b&gt; (WAN mode only)&lt;br&gt;IUPnPNAT COM, double-NAT check" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1365" y="232" width="300" height="50" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Listener / session loop&lt;/b&gt; (main thread)&lt;br&gt;bind+listen video &amp;amp; input ports, accept both&lt;br&gt;recv PKT_HANDSHAKE → &lt;b&gt;ShowConsentDialog(name)&lt;/b&gt;&lt;br&gt;→ PKT_HANDSHAKE_ACK / DENY; reset AES counters" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1055" y="296" width="610" height="74" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;InputThread&lt;/b&gt;&lt;br&gt;recv mouse/key packets&lt;br&gt;CryptInputRecv → &lt;b&gt;SendInput()&lt;/b&gt;&lt;br&gt;Ctrl+Alt+Del → SAS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1055" y="395" width="200" height="90" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;VideoStreamThread&lt;/b&gt;&lt;br&gt;SwitchToInputDesktop&lt;br&gt;BitBlt capture (CAPTUREBLT)&lt;br&gt;GDI+ JPEG encode&lt;br&gt;CryptVideoSend (AES-CTR)&lt;br&gt;→ PKT_VIDEO_FRAME" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1055" y="505" width="200" height="120" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;AudioStreamThread&lt;/b&gt;&lt;br&gt;own listener on audio port&lt;br&gt;WASAPI loopback capture&lt;br&gt;→ PCM16 → PKT_AUDIO_FRAME" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1055" y="645" width="200" height="90" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;HeartbeatThread&lt;/b&gt;&lt;br&gt;PKT_HEARTBEAT every 5 s&lt;br&gt;(on video socket)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1270" y="395" width="190" height="66" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;BandwidthController&lt;/b&gt;&lt;br&gt;JPEG quality ladder&lt;br&gt;15 / 30 / 50 / 75; step down&lt;br&gt;when over 33 ms budget,&lt;br&gt;up after 10 fast frames" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1270" y="510" width="190" height="100" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Logger thread&lt;/b&gt;&lt;br&gt;LogWorker queue" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1270" y="665" width="190" height="50" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;RunStatusWindow&lt;/b&gt; thread&lt;br&gt;status window + tray icon&lt;br&gt;(controller name, UPnP state)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1475" y="395" width="190" height="66" as="geometry"/></mxCell><mxCell id="c48" value="Per session the main thread spawns Input, Video, Heartbeat and StatusWindow threads; when the session ends they are joined and it returns to accept()." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;shape=note;size=14;fillColor=#FFF9E6;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1475" y="480" width="190" height="110" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;settings.dat&lt;/b&gt; (next to host.exe)&lt;br&gt;video_port · input_port&lt;br&gt;audio_port · connection =&lt;br&gt;LAN|WAN · passphrase" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;shape=note;size=14;fillColor=#FFF9E6;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1475" y="605" width="190" height="80" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Security: passphrase → AES-128-CTR on video &amp;amp; input payloads; the audio stream is sent in clear.&lt;br&gt;• UPnP maps only the video &amp;amp; input ports – the audio port needs manual forwarding in WAN mode.&lt;br&gt;• Host requires Administrator (SendInput to elevated / secure desktop, firewall rules)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;shape=note;size=14;fillColor=#FDECEA;strokeColor=#B85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1055" y="760" width="610" height="76" as="geometry"/></mxCell><mxCell id="c51" value="Windows APIs: GDI BitBlt · GDI+ JPEG · WASAPI (IAudioClient loopback) · SendInput · OpenInputDesktop · UPnP NAT COM · netsh · Registry · Shell_NotifyIcon · Winsock2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1040" y="945" width="640" height="46" as="geometry"/></mxCell><mxCell id="c52" value="" style="edgeStyl